{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node", "config": { "maxDuration": 300, "memory": 1024 } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/kiosk", "dest": "/server.js" },
    { "src": "/closing", "dest": "/server.js" },
    { "src": "/crm", "dest": "/server.js" },
    { "src": "/c", "dest": "/server.js" },
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/overlay.js", "dest": "/public/overlay.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|xlsx|json))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/crawl-la2f",
      "schedule": "*/30 * * * *"
    }
  ]
}
